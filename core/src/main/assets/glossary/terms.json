{
  "terms": [
    {
      "id": "g-001",
      "term": "カバレッジ",
      "chapters": [
        1,
        4
      ],
      "summary": "カバーすべき要素（カバレッジアイテム）のうち、テストで通せた割合。パーセントで表す。"
    },
    {
      "id": "g-002",
      "term": "デバッグ",
      "chapters": [
        1
      ],
      "summary": "故障の原因になった欠陥を突き止めて直す作業。テストとは別の活動。"
    },
    {
      "id": "g-003",
      "term": "欠陥",
      "chapters": [
        1
      ],
      "summary": "エラーによって作業成果物に作り込まれた誤り。実行されると故障を起こすことがある。"
    },
    {
      "id": "g-004",
      "term": "エラー",
      "chapters": [
        1
      ],
      "summary": "人の思い違いや誤った行動。欠陥を作り込む原因になる。"
    },
    {
      "id": "g-005",
      "term": "故障",
      "chapters": [
        1
      ],
      "summary": "実行中に、すべきことをしない／すべきでないことをする事象。欠陥の実行で起こりうる。"
    },
    {
      "id": "g-006",
      "term": "品質",
      "chapters": [
        1
      ],
      "summary": "ユーザーやステークホルダーのニーズ・期待を、どの程度満たしているかの度合い。"
    },
    {
      "id": "g-007",
      "term": "品質保証",
      "chapters": [
        1
      ],
      "summary": "プロセスを整え改善して欠陥を予防する、プロセス指向の取り組み。テスト自体は品質コントロールに当たる。"
    },
    {
      "id": "g-008",
      "term": "根本原因",
      "chapters": [
        1
      ],
      "summary": "問題が起きたおおもとの理由。取り除けば、同じような欠陥や故障の再発を減らせる。"
    },
    {
      "id": "g-009",
      "term": "テスト分析",
      "chapters": [
        1
      ],
      "summary": "テストベースを調べて「何をテストするか」（テスト条件）を決める活動。"
    },
    {
      "id": "g-010",
      "term": "テストベース",
      "chapters": [
        1
      ],
      "summary": "テスト分析やテスト設計のよりどころにする情報（要件、設計書、コードなど）。"
    },
    {
      "id": "g-011",
      "term": "テストケース",
      "chapters": [
        1
      ],
      "summary": "テスト条件をもとにテスト設計で作る、事前条件・入力・操作・期待結果のひとそろい。"
    },
    {
      "id": "g-012",
      "term": "テスト完了",
      "chapters": [
        1
      ],
      "summary": "区切りの時点でテストウェアを整理・保管し、教訓をまとめて報告する活動。"
    },
    {
      "id": "g-013",
      "term": "テスト条件",
      "chapters": [
        1
      ],
      "summary": "テストで確かめるべき側面。テスト分析で決める「何をテストするか」にあたる。"
    },
    {
      "id": "g-014",
      "term": "テストコントロール",
      "chapters": [
        1,
        5
      ],
      "summary": "テストモニタリングで得た情報をもとに、是正や調整の指示を出してテストを導く活動。"
    },
    {
      "id": "g-015",
      "term": "テストデータ",
      "chapters": [
        1
      ],
      "summary": "テストの実行に使うために用意する入力値や、あらかじめ作っておくデータ。"
    },
    {
      "id": "g-016",
      "term": "テスト設計",
      "chapters": [
        1
      ],
      "summary": "テスト条件をテストケースなどに具体化して「どうテストするか」を決める活動。"
    },
    {
      "id": "g-017",
      "term": "テスト実行",
      "chapters": [
        1
      ],
      "summary": "手順やスクリプトに沿ってテストを動かし、実際の結果を期待結果と比べる活動。"
    },
    {
      "id": "g-018",
      "term": "テスト実装",
      "chapters": [
        1
      ],
      "summary": "実行の前に、テストプロシジャーやテストデータ、テスト環境などをそろえる活動。"
    },
    {
      "id": "g-019",
      "term": "テストモニタリング",
      "chapters": [
        1,
        5
      ],
      "summary": "テストに関する情報を集め続け、実際の進捗を計画と比べて評価する活動。"
    },
    {
      "id": "g-020",
      "term": "テスト対象",
      "chapters": [
        1,
        2
      ],
      "summary": "テストされる作業成果物。システムやコンポーネント、ドキュメントなど。"
    },
    {
      "id": "g-021",
      "term": "テスト目的",
      "chapters": [
        1
      ],
      "summary": "そのテストを行うねらい（欠陥を見つける、品質への確信を得るなど）。"
    },
    {
      "id": "g-022",
      "term": "テスト計画",
      "chapters": [
        1,
        5
      ],
      "summary": "テスト目的を定め、制約の中でそれを達成する進め方を決める活動。結果はテスト計画書に書く。"
    },
    {
      "id": "g-023",
      "term": "テストプロシジャー",
      "chapters": [
        1
      ],
      "summary": "複数のテストケースを実行順に並べ、準備などの手順も加えたもの。テスト実装で作る。"
    },
    {
      "id": "g-024",
      "term": "テスト結果",
      "chapters": [
        1
      ],
      "summary": "テストを実行して分かったこと（合格・不合格など）。"
    },
    {
      "id": "g-025",
      "term": "テスト",
      "chapters": [
        1
      ],
      "summary": "欠陥を見つけ、作業成果物の品質を評価するために行う活動のまとまり。動かす方法と動かさない方法がある。"
    },
    {
      "id": "g-026",
      "term": "テストウェア",
      "chapters": [
        1
      ],
      "summary": "テスト活動で作られる作業成果物の総称（計画書、テストケース、スクリプト、レポートなど）。"
    },
    {
      "id": "g-027",
      "term": "妥当性確認",
      "chapters": [
        1
      ],
      "summary": "ユーザーなどのニーズを運用の場で満たすかを確かめること（正しいものを作っているか）。"
    },
    {
      "id": "g-028",
      "term": "検証",
      "chapters": [
        1
      ],
      "summary": "決められた要件や仕様のとおりに作れているかを確かめること（正しく作っているか）。"
    },
    {
      "id": "g-029",
      "term": "受け入れテスト",
      "chapters": [
        2
      ],
      "summary": "妥当性確認が中心のテストレベル。ユーザーの業務ニーズに合い、デプロイできる状態かを確かめる。"
    },
    {
      "id": "g-030",
      "term": "ブラックボックステスト",
      "chapters": [
        2
      ],
      "summary": "仕様をもとに、外から見た振る舞いを確かめるテストタイプ。内部構造は参照しない。"
    },
    {
      "id": "g-031",
      "term": "コンポーネント統合テスト",
      "chapters": [
        2
      ],
      "summary": "コンポーネント同士のインターフェースとやり取りを確かめるテストレベル。"
    },
    {
      "id": "g-032",
      "term": "コンポーネントテスト",
      "chapters": [
        2
      ],
      "summary": "コンポーネントを単独で確かめるテストレベル。主に開発担当者が行う。"
    },
    {
      "id": "g-033",
      "term": "確認テスト",
      "chapters": [
        2
      ],
      "summary": "修正した欠陥が本当に直ったことを確かめるテスト。"
    },
    {
      "id": "g-034",
      "term": "機能テスト",
      "chapters": [
        2
      ],
      "summary": "コンポーネントやシステムが「何をするか」（機能）を評価するテストタイプ。"
    },
    {
      "id": "g-035",
      "term": "統合テスト",
      "chapters": [
        2
      ],
      "summary": "要素間のインターフェースと相互作用を確かめるテスト。コンポーネント統合とシステム統合がある。"
    },
    {
      "id": "g-036",
      "term": "メンテナンステスト",
      "chapters": [
        2
      ],
      "summary": "運用中のシステムの変更や、移行・廃棄に伴って行うテスト。"
    },
    {
      "id": "g-037",
      "term": "非機能テスト",
      "chapters": [
        2
      ],
      "summary": "性能・使用性・セキュリティなど「どれだけうまく動くか」を確かめるテストタイプ。"
    },
    {
      "id": "g-038",
      "term": "リグレッションテスト",
      "chapters": [
        2
      ],
      "summary": "変更（欠陥の修正を含む）によって、意図しない悪影響が出ていないことを確かめるテスト。"
    },
    {
      "id": "g-039",
      "term": "シフトレフト",
      "chapters": [
        2
      ],
      "summary": "テストやレビューを、ライフサイクルのより早い段階で行う考え方。"
    },
    {
      "id": "g-040",
      "term": "システム統合テスト",
      "chapters": [
        2
      ],
      "summary": "テスト対象のシステムと、他のシステムや外部サービスとの連携を確かめるテストレベル。"
    },
    {
      "id": "g-041",
      "term": "システムテスト",
      "chapters": [
        2
      ],
      "summary": "システム全体の振る舞いと能力を確かめるテストレベル。"
    },
    {
      "id": "g-042",
      "term": "テストレベル",
      "chapters": [
        2
      ],
      "summary": "開発段階に応じてまとめて管理するテスト活動のグループ。コンポーネントテスト〜受け入れテスト。"
    },
    {
      "id": "g-043",
      "term": "テストタイプ",
      "chapters": [
        2
      ],
      "summary": "特定の品質特性に注目したテスト活動のグループ。ほとんどはどのテストレベルでも行える。"
    },
    {
      "id": "g-044",
      "term": "ホワイトボックステスト",
      "chapters": [
        2
      ],
      "summary": "実装や内部構造（コードなど）をもとにテストを導くテストタイプ。"
    },
    {
      "id": "g-045",
      "term": "不正",
      "chapters": [
        3
      ],
      "summary": "期待と違って見える事象。分析するまでは欠陥とは限らない（偽陽性や変更要求のこともある）。"
    },
    {
      "id": "g-046",
      "term": "動的テスト",
      "chapters": [
        3
      ],
      "summary": "ソフトウェアを実際に実行して行うテスト。故障を起こし、分析して欠陥を特定する。"
    },
    {
      "id": "g-047",
      "term": "形式的レビュー",
      "chapters": [
        3
      ],
      "summary": "決められたプロセスと役割に従い、結果を文書に残すレビュー。"
    },
    {
      "id": "g-048",
      "term": "非形式的レビュー",
      "chapters": [
        3
      ],
      "summary": "決まったプロセスに従わず、正式な記録も求めない手軽なレビュー。主な目的は不正の検出。"
    },
    {
      "id": "g-049",
      "term": "インスペクション",
      "chapters": [
        3
      ],
      "summary": "最も形式的なレビュー。不正をできるだけ多く見つけるのが主目的で、メトリクスも集める。"
    },
    {
      "id": "g-050",
      "term": "レビュー",
      "chapters": [
        3
      ],
      "summary": "人が作業成果物を読んで評価し、欠陥や改善点を見つける静的テスト。"
    },
    {
      "id": "g-051",
      "term": "静的解析",
      "chapters": [
        3
      ],
      "summary": "ツールを使い、実行せずにコードなどを調べる静的テストの一種。"
    },
    {
      "id": "g-052",
      "term": "静的テスト",
      "chapters": [
        3
      ],
      "summary": "ソフトウェアを実行せず、レビューや静的解析で作業成果物を評価するテスト。欠陥を直接見つける。"
    },
    {
      "id": "g-053",
      "term": "テクニカルレビュー",
      "chapters": [
        3
      ],
      "summary": "技術に詳しいレビューアが行い、モデレーターが主導する。技術的な問題の合意と判断がねらい。"
    },
    {
      "id": "g-054",
      "term": "ウォークスルー",
      "chapters": [
        3
      ],
      "summary": "作成者が主導するレビュー。レビューアの教育や合意形成など、目的が幅広い。"
    },
    {
      "id": "g-055",
      "term": "受け入れ基準",
      "chapters": [
        4
      ],
      "summary": "ユーザーストーリーなどがステークホルダーに受け入れられるために満たすべき条件。"
    },
    {
      "id": "g-056",
      "term": "受け入れテスト駆動開発",
      "chapters": [
        4
      ],
      "summary": "実装の前に、受け入れ基準からテストケースをチームで協力して作る進め方（ATDD）。"
    },
    {
      "id": "g-057",
      "term": "ブラックボックステスト技法",
      "chapters": [
        4
      ],
      "summary": "内部構造を参照せず、仕様に書かれた振る舞いからテストを導く技法。"
    },
    {
      "id": "g-058",
      "term": "境界値分析",
      "chapters": [
        4
      ],
      "summary": "順序のある同値パーティションの境目の値を狙ってテストする技法。"
    },
    {
      "id": "g-059",
      "term": "ブランチカバレッジ",
      "chapters": [
        4
      ],
      "summary": "テストで通したブランチ（制御の流れの枝）の割合。100%ならステートメントカバレッジも100%。"
    },
    {
      "id": "g-060",
      "term": "チェックリストベースドテスト",
      "chapters": [
        4
      ],
      "summary": "経験や知識をまとめたチェックリストの項目を確かめるようにテストする技法。"
    },
    {
      "id": "g-061",
      "term": "コラボレーションベースのテストアプローチ",
      "chapters": [
        4
      ],
      "summary": "協力と対話を通じて、欠陥の検出だけでなく欠陥を作り込まないこともねらう進め方。"
    },
    {
      "id": "g-062",
      "term": "カバレッジアイテム",
      "chapters": [
        4
      ],
      "summary": "テスト技法ごとに決まる、カバーすべき要素（同値パーティション、ブランチなど）。"
    },
    {
      "id": "g-063",
      "term": "デシジョンテーブルテスト",
      "chapters": [
        4
      ],
      "summary": "条件の組み合わせと、その結果の動作を表にまとめてテストする技法。"
    },
    {
      "id": "g-064",
      "term": "同値分割法",
      "chapters": [
        4
      ],
      "summary": "同じように処理されるはずの値を同値パーティションにまとめ、各パーティションを代表値でテストする技法。"
    },
    {
      "id": "g-065",
      "term": "エラー推測",
      "chapters": [
        4
      ],
      "summary": "経験をもとに、起こりそうなエラー・欠陥・故障を予想してテストする技法。"
    },
    {
      "id": "g-066",
      "term": "経験ベースのテスト技法",
      "chapters": [
        4
      ],
      "summary": "テスト担当者の知識・経験・直感を使ってテストを導く技法。"
    },
    {
      "id": "g-067",
      "term": "探索的テスト",
      "chapters": [
        4
      ],
      "summary": "対象を学びながら、テストの設計・実行・評価を同時に進めるテスト。"
    },
    {
      "id": "g-068",
      "term": "状態遷移テスト",
      "chapters": [
        4
      ],
      "summary": "状態と、イベントによる状態の移り変わりを表したモデルをもとにテストする技法。"
    },
    {
      "id": "g-069",
      "term": "ステートメントカバレッジ",
      "chapters": [
        4
      ],
      "summary": "テストで実行した実行可能ステートメントの割合。100%でも全ブランチを通したとは限らない。"
    },
    {
      "id": "g-070",
      "term": "テスト技法",
      "chapters": [
        4
      ],
      "summary": "テスト条件・テストケース・テストデータを系統立てて導き出すための方法。"
    },
    {
      "id": "g-071",
      "term": "ホワイトボックステスト技法",
      "chapters": [
        4
      ],
      "summary": "テスト対象の内部構造や処理を分析してテストを導く技法。"
    },
    {
      "id": "g-072",
      "term": "欠陥マネジメント",
      "chapters": [
        5
      ],
      "summary": "不正を記録し、分析・分類して、発見から終結まで管理するプロセス。"
    },
    {
      "id": "g-073",
      "term": "欠陥レポート",
      "chapters": [
        5
      ],
      "summary": "見つけた不正を、対処に必要な情報を添えて記録・報告する文書。"
    },
    {
      "id": "g-074",
      "term": "開始基準",
      "chapters": [
        5
      ],
      "summary": "ある活動を始める前に満たしておくべき事前条件。アジャイルでは「準備完了の定義」と呼ぶ。"
    },
    {
      "id": "g-075",
      "term": "終了基準",
      "chapters": [
        5
      ],
      "summary": "ある活動が完了したと言うために満たすべき条件。アジャイルでは「完了の定義」と呼ぶ。"
    },
    {
      "id": "g-076",
      "term": "プロダクトリスク",
      "chapters": [
        5
      ],
      "summary": "プロダクトの品質特性に関わるリスク（機能の誤り、性能の不足など）。"
    },
    {
      "id": "g-077",
      "term": "プロジェクトリスク",
      "chapters": [
        5
      ],
      "summary": "プロジェクトのマネジメントに関わるリスク（納期の遅れ、人手不足など）。日程や予算に響く。"
    },
    {
      "id": "g-078",
      "term": "リスク",
      "chapters": [
        5
      ],
      "summary": "将来起こるかもしれない、悪い結果につながる事象や状況。"
    },
    {
      "id": "g-079",
      "term": "リスク分析",
      "chapters": [
        5
      ],
      "summary": "リスクを洗い出し（リスク識別）、評価する（リスクアセスメント）活動。"
    },
    {
      "id": "g-080",
      "term": "リスクアセスメント",
      "chapters": [
        5
      ],
      "summary": "識別したリスクの可能性と影響からリスクレベルを決め、優先順位と対処法を出す活動。"
    },
    {
      "id": "g-081",
      "term": "リスクコントロール",
      "chapters": [
        5
      ],
      "summary": "分析したリスクへの対策全般。リスク軽減とリスクモニタリングからなる。"
    },
    {
      "id": "g-082",
      "term": "リスク識別",
      "chapters": [
        5
      ],
      "summary": "どんなリスクがあるかを洗い出す活動。"
    },
    {
      "id": "g-083",
      "term": "リスクレベル",
      "chapters": [
        5
      ],
      "summary": "リスクの大きさ。リスクの可能性（確率）と、リスクの影響（損害）の2つで決まる。"
    },
    {
      "id": "g-084",
      "term": "リスクマネジメント",
      "chapters": [
        5
      ],
      "summary": "リスク分析とリスクコントロールを合わせた、リスクに対処する活動の全体。"
    },
    {
      "id": "g-085",
      "term": "リスク軽減",
      "chapters": [
